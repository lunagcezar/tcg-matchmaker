{
  "name": "tcg-matchmaker",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "dev": "concurrently \"pnpm -F @tcg/worker dev\" \"pnpm -F @tcg/frontend dev\"",
    "dev:restart": "lsof -ti :8787 | xargs -r kill -9 2>/dev/null; lsof -ti :9000 | xargs -r kill -9 2>/dev/null; sleep 1; concurrently \"pnpm -F @tcg/worker dev\" \"pnpm -F @tcg/frontend dev\"",
    "dev:e2e": "concurrently -k \"pnpm -F @tcg/worker dev\" \"pnpm -F @tcg/frontend dev\" \"pnpm -F @tcg/frontend test:e2e\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -F @tcg/frontend test:coverage",
    "test:e2e": "pnpm -F @tcg/frontend test:e2e",
    "lint": "pnpm format:check && pnpm -r lint",
    "lint:strict": "oxlint . -W suspicious -W perf",
    "lint:fix": "pnpm format && pnpm -r lint:fix",
    "typecheck": "pnpm -r typecheck",
    "knip": "knip",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts",
    "db:setup": "bash scripts/setup-dev.sh"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx,vue}": [
      "oxlint --fix",
      "oxfmt --write"
    ],
    "*.{json,jsonc,md,mdx,css,scss,less,html,yaml,yml,toml,graphql}": [
      "oxfmt --write"
    ]
  },
  "packageManager": "pnpm@11.24.0"
}
