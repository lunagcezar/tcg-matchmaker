{
  "name": "tcg-matchmaker",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "concurrently \"pnpm -F @tcg/worker dev\" \"pnpm -F @tcg/frontend dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -F @tcg/frontend test:e2e",
    "lint": "pnpm -r lint && eslint packages/shared/src packages/worker/src --ext .ts",
    "format": "prettier --write \"**/*.{ts,vue,json,md,yaml,yml}\" --ignore-path .gitignore",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/shared/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "packages/worker/src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
