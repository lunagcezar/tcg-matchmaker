{
  "name": "tcg-matchmaker",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "concurrently \"pnpm -F @tcg/worker dev\" \"pnpm -F @tcg/frontend dev\"",
    "dev:restart": "lsof -ti :8787 | xargs -r kill -9 2>/dev/null; lsof -ti :9000 | xargs -r kill -9 2>/dev/null; sleep 1; concurrently \"pnpm -F @tcg/worker dev\" \"pnpm -F @tcg/frontend dev\"",
    "dev:e2e": "concurrently -k \"pnpm -F @tcg/worker dev\" \"pnpm -F @tcg/frontend dev\" \"pnpm -F @tcg/frontend test:e2e\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -F @tcg/frontend test:e2e",
    "lint": "pnpm format:check && eslint --cache . && pnpm -r lint",
    "lint:fix": "pnpm format && eslint --cache . --fix && pnpm -r lint:fix",
    "format": "prettier --write \"**/*.{js,ts,vue,css,scss,html,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{js,ts,vue,css,scss,html,json,md,yaml,yml}\"",
    "prepare": "husky",
    "db:types": "supabase gen types typescript --local > packages/shared/src/database.types.ts"
  },
  "lint-staged": {
    "*.{js,mjs,ts,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml,css,scss,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-prettier": "^5.2.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0"
  }
}
