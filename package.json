{
  "name": "tcg-matchmaker",
  "private": true,
  "packageManager": "pnpm@11.13.0",
  "scripts": {
    "dev": "concurrently \"pnpm -F @tcg/worker dev\" \"pnpm -F @tcg/frontend dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint && eslint packages/shared/src packages/worker/src --ext .ts",
    "format": "prettier --write \"**/*.{ts,vue,json,md,yaml,yml}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "concurrently": "^9.1.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0"
  }
}
