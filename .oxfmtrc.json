{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "semi": true,
  "arrowParens": "always",
  "sortImports": true,
  "sortPackageJson": true,
  "ignorePatterns": [
    ".agents/",
    "dist/",
    "coverage/",
    "node_modules/",
    ".quasar/",
    ".wrangler/",
    ".supabase/",
    "*.local",
    "pnpm-lock.yaml"
  ]
}
